Grammar

    0 $accept: program $end

    1 program: sentence_list

    2 repeat_start: REPEAT arithmetic_expression DO NEWLINE_TKN

    3 repeat_end: repeat_start sentence_list DONE NEWLINE_TKN

    4 sentence_list: sentence_list sentence
    5              | sentence
    6              | repeat_end
    7              | sentence_list repeat_end

    8 sentence: expression NEWLINE_TKN
    9         | assignment
   10         | representation_mode NEWLINE_TKN
   11         | NEWLINE_TKN

   12 representation_mode: BIN
   13                    | OCT
   14                    | DEC
   15                    | HEX
   16                    | RIC

   17 assignment: ID_TKN ASSIGN expression NEWLINE_TKN

   18 expression: arithmetic_expression

   19 arithmetic_expression: exp

   20 exp: exp1 ADDITION exp
   21    | exp1 SUBSTRACTION exp
   22    | exp1

   23 exp1: SUBSTRACTION exp2
   24     | ADDITION exp2
   25     | exp2

   26 exp2: exp3 MULTIPLICATION exp2
   27     | exp3 DIVISION exp2
   28     | exp3 MOD exp2
   29     | exp3

   30 exp3: exp4 POWER exp3
   31     | SIN exp4
   32     | COS exp4
   33     | TAN exp4
   34     | exp4

   35 exp4: OPENPAR exp CLOSEDPAR
   36     | INTEGER_TKN
   37     | FLOAT_TKN
   38     | ID_TKN


